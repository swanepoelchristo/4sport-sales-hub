# These values are auto-populated by Lovable Cloud during development.
# For self-hosting on your Ubuntu server, fill these in with your Supabase project values.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Server-only (for the seed script). Never expose to the browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# WhatsApp Cloud API webhook configuration. Server-only.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-long-random-string
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_ACCESS_TOKEN=your_server_side_meta_access_token
WHATSAPP_GRAPH_API_VERSION=set_the_approved_graph_api_version

# Guarded Sales Hub -> Christo Sidekick intake bridge. Server-only.
# Example production value: https://sidekick.example.com
SIDEKICK_INTAKE_URL=http://localhost:3000
SIDEKICK_INTAKE_API_KEY=use-the-same-scoped-intake-key-configured-in-sidekick
SIDEKICK_OUTBOX_SECRET=use-a-separate-long-random-worker-secret

# Read-only Gmail and Afrihost mailbox intake. Server-only.
# Gmail requires IMAP enabled and a Google App Password; never use your normal Google password.
SIDEKICK_EMAIL_POLL_SECRET=use-another-long-random-scheduled-task-secret
EMAIL_INTAKE_LOOKBACK_HOURS=24
EMAIL_INTAKE_MAX_MESSAGES=20

GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_SECURE=true
GMAIL_IMAP_USER=your-gmail-address
GMAIL_IMAP_PASSWORD=your-google-app-password

AFRIHOST_IMAP_HOST=your-afrihost-imap-host
AFRIHOST_IMAP_PORT=993
AFRIHOST_IMAP_SECURE=true
AFRIHOST_IMAP_USER=your-afrihost-email-address
AFRIHOST_IMAP_PASSWORD=your-afrihost-mailbox-password

# PR #8 automatic public lead research engine
# Server-side only. Do not expose this as VITE_ variable.
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
# Read-only organisation evidence exported by the SuperSport Schools connector. Server-only.
# Use the connector's guarded GET /api/organisation-evidence endpoint.
SUPERSPORT_EVIDENCE_EXPORT_URL=https://your-connector.example.com/api/organisation-evidence
SUPERSPORT_EVIDENCE_EXPORT_SECRET=use-a-dedicated-long-random-read-only-secret
